#: helios/election_progress.py:19
msgid "Result released"
msgstr "Ergebnis freigegeben"

#: helios/election_progress.py:21
msgid "In preparation"
msgstr "In Vorbereitung"

#: helios/election_progress.py:23
msgid "Counting"
msgstr "Auszählung läuft"

#: helios/election_progress.py:25
msgid "Voting closed"
msgstr "Stimmabgabe beendet"

#: helios/election_progress.py:27
msgid "Opens soon"
msgstr "Öffnet bald"

#: helios/election_progress.py:28
msgid "Voting open"
msgstr "Stimmabgabe offen"

#: helios/election_progress.py:50
#, python-format
msgid "%(count)d question"
msgid_plural "%(count)d questions"
msgstr[0] "%(count)d Frage"
msgstr[1] "%(count)d Fragen"

#: helios/election_progress.py:52
msgid "No questions yet"
msgstr "Noch keine Fragen"

#: helios/election_progress.py:53
msgid "Ballot questions"
msgstr "Fragen auf dem Stimmzettel"

#: helios/election_progress.py:54
msgid "What voters are asked and which answers they can choose."
msgstr "Was die Wahlberechtigten gefragt werden und welche Antworten sie wählen können."

#: helios/election_progress.py:58
msgid "Anyone who can log in may vote"
msgstr "Alle, die sich anmelden können, dürfen abstimmen"

#: helios/election_progress.py:60
#, python-format
msgid "%(count)d voter"
msgid_plural "%(count)d voters"
msgstr[0] "%(count)d wahlberechtigte Person"
msgstr[1] "%(count)d Wahlberechtigte"

#: helios/election_progress.py:62
msgid "No voters yet"
msgstr "Noch keine Wahlberechtigten"

#: helios/election_progress.py:63 helios/templates/votergroup_prepareelection.html:14
msgid "Voters"
msgstr "Wahlberechtigte"

#: helios/election_progress.py:64
msgid "Who may vote. Upload a list of voters as a CSV file."
msgstr "Wer abstimmen darf. Laden Sie die Liste der Wahlberechtigten als CSV-Datei hoch."

#: helios/election_progress.py:69
msgid "No trustees yet"
msgstr "Noch keine Treuhänder*innen"

#: helios/election_progress.py:71
#, python-format
msgid "Waiting for the key of %(names)s"
msgid_plural "Waiting for the keys of %(names)s"
msgstr[0] "Warten auf den Schlüssel von %(names)s"
msgstr[1] "Warten auf die Schlüssel von %(names)s"

#: helios/election_progress.py:74
#, python-format
msgid "%(count)d trustee, key ready"
msgid_plural "%(count)d trustees, keys ready"
msgstr[0] "%(count)d Treuhänder*in, Schlüssel bereit"
msgstr[1] "%(count)d Treuhänder*innen, Schlüssel bereit"

#: helios/election_progress.py:75 helios/templates/list_trustees.html:7
msgid "Trustees"
msgstr "Treuhänder*innen"

#: helios/election_progress.py:76
msgid "Who holds the keys that decrypt the result. Helios itself is a trustee unless you change it."
msgstr "Wer die Schlüssel hält, mit denen das Ergebnis entschlüsselt wird. Helios selbst ist Treuhänder*in, sofern Sie das nicht ändern."

#: helios/election_progress.py:81
msgid "Done: the ballot can no longer be changed"
msgstr "Erledigt: Der Stimmzettel kann nicht mehr geändert werden"

#: helios/election_progress.py:83 helios/election_progress.py:97 helios/election_progress.py:112
#: helios/election_progress.py:118
msgid "Not yet"
msgstr "Noch nicht"

#: helios/election_progress.py:84
msgid "Freeze the ballot and open the election"
msgstr "Stimmzettel einfrieren und Wahl öffnen"

#: helios/election_progress.py:85
msgid "Fixes questions, answers and trustees for good. Voting opens now or at the scheduled time."
msgstr "Legt Fragen, Antworten und Treuhänder*innen endgültig fest. Die Stimmabgabe beginnt sofort oder zum geplanten Zeitpunkt."

#: helios/election_progress.py:92
#, python-format
msgid "%(count)d ballot cast"
msgid_plural "%(count)d ballots cast"
msgstr[0] "%(count)d Stimme abgegeben"
msgstr[1] "%(count)d Stimmen abgegeben"

#: helios/election_progress.py:94
#, python-format
msgid "%(cast)d of %(total)d voter has voted"
msgid_plural "%(cast)d of %(total)d voters have voted"
msgstr[0] "%(cast)d von %(total)d wahlberechtigten Person hat abgestimmt"
msgstr[1] "%(cast)d von %(total)d Wahlberechtigten haben abgestimmt"

#: helios/election_progress.py:98
msgid "Voting"
msgstr "Stimmabgabe"

#: helios/election_progress.py:99
msgid "Send voters their invitation and follow the turnout in the ballot tracking center."
msgstr "Senden Sie den Wahlberechtigten ihre Einladung und verfolgen Sie die Beteiligung in der Stimmzettel-Übersicht."

#: helios/election_progress.py:105
msgid "Done"
msgstr "Erledigt"

#: helios/election_progress.py:105
msgid "Done: only you can see the result so far"
msgstr "Erledigt: Bisher sehen nur Sie das Ergebnis"

#: helios/election_progress.py:108
#, python-format
msgid "%(done)d of %(total)d trustees have decrypted their share"
msgstr "%(done)d von %(total)d Treuhänder*innen haben ihren Anteil entschlüsselt"

#: helios/election_progress.py:110
msgid "Under way"
msgstr "Läuft"

#: helios/election_progress.py:113
msgid "Count the votes"
msgstr "Stimmen auszählen"

#: helios/election_progress.py:114
msgid "Ends voting and adds up the encrypted ballots; the trustees then decrypt only the totals."
msgstr "Beendet die Stimmabgabe und addiert die verschlüsselten Stimmzettel; die Treuhänder*innen entschlüsseln danach nur die Summen."

#: helios/election_progress.py:117
msgid "Release the result"
msgstr "Ergebnis freigeben"

#: helios/election_progress.py:118
msgid "Done: the result is public"
msgstr "Erledigt: Das Ergebnis ist öffentlich"

#: helios/election_progress.py:119
msgid "Makes the result visible to everyone and lets you notify the voters."
msgstr "Macht das Ergebnis für alle sichtbar; danach können Sie die Wahlberechtigten benachrichtigen."

#: helios/forms.py:14 helios/votergroup.py:18
msgid "Short name"
msgstr "Kurzname"

#: helios/forms.py:14
msgid "no spaces, will be part of the URL for your election, e.g. my-club-2010"
msgstr "ohne Leerzeichen, wird Teil der URL Ihrer Wahl, z. B. mein-verein-2010"

#: helios/forms.py:15 helios/templates/election_bboard.html:41 helios/templates/voters_list.html:144
#: helios/templates/voters_manage.html:28 helios/templates/voters_upload_confirm.html:12
msgid "Name"
msgstr "Name"

#: helios/forms.py:15
msgid "the pretty name for your election, e.g. My Club 2010 Election"
msgstr "der angezeigte Name Ihrer Wahl, z. B. Vorstandswahl Mein Verein 2010"

#: helios/forms.py:16
msgid "Description"
msgstr "Beschreibung"

#: helios/forms.py:17
msgid "type"
msgstr "Art"

#: helios/forms.py:18
msgid "If selected, voter identities will be replaced with aliases, e.g. \"V12\", in the ballot tracking center"
msgstr "Wenn ausgewählt, werden die Identitäten der Wahlberechtigten in der Stimmzettel-Übersicht durch Aliasse ersetzt, z. B. „V12“"

#: helios/forms.py:18
msgid "Use voter aliases"
msgstr "Aliasse für Wahlberechtigte verwenden"

#: helios/forms.py:20
msgid "Randomize answer order"
msgstr "Antworten in zufälliger Reihenfolge"

#: helios/forms.py:20
msgid "enable this if you want the answers to questions to appear in random order for each voter"
msgstr "aktivieren, wenn die Antworten auf Fragen jeder wahlberechtigten Person in zufälliger Reihenfolge angezeigt werden sollen"

#: helios/forms.py:21
msgid "A private election is only visible to registered voters."
msgstr "Eine nicht öffentliche Wahl ist nur für eingetragene Wahlberechtigte sichtbar."

#: helios/forms.py:21
msgid "Private?"
msgstr "Nicht öffentlich?"

#: helios/forms.py:22
msgid "An email address voters should contact if they need help."
msgstr "Eine E-Mail-Adresse, an die sich Wahlberechtigte wenden können, wenn sie Hilfe benötigen."

#: helios/forms.py:22
msgid "Help Email Address"
msgstr "Hilfe-E-Mail-Adresse"

#: helios/forms.py:25
msgid "Election Info Download URL"
msgstr "Download-URL für Wahlinformationen"

#: helios/forms.py:25
msgid "the URL of a PDF document that contains extra election information, e.g. candidate bios and statements"
msgstr "die URL eines PDF-Dokuments mit zusätzlichen Informationen zur Wahl, z. B. Lebensläufe und Stellungnahmen der Kandidierenden"

#: helios/forms.py:28
msgid "UTC date and time when voting begins"
msgstr "Datum und Uhrzeit (UTC), zu der die Stimmabgabe beginnt"

#: helios/forms.py:28
msgid "Voting starts at"
msgstr "Beginn der Stimmabgabe"

#: helios/forms.py:30
msgid "UTC date and time when voting ends"
msgstr "Datum und Uhrzeit (UTC), zu der die Stimmabgabe endet"

#: helios/forms.py:30
msgid "Voting ends at"
msgstr "Ende der Stimmabgabe"

#: helios/forms.py:34
msgid "UTC date and time voting extended to"
msgstr "Datum und Uhrzeit (UTC), bis zu der die Stimmabgabe verlängert wird"

#: helios/forms.py:34
msgid "Voting extended until"
msgstr "Stimmabgabe verlängert bis"

#: helios/forms.py:38 helios/forms.py:54
msgid "Subject"
msgstr "Betreff"

#: helios/forms.py:39 helios/forms.py:55
msgid "Body"
msgstr "Text"

#: helios/forms.py:40 helios/forms.py:56
msgid "Send To"
msgstr "Senden an"

#: helios/forms.py:40 helios/forms.py:56
msgid "all voters"
msgstr "alle Wahlberechtigten"

#: helios/forms.py:40
msgid "voters who have cast a ballot"
msgstr "Wahlberechtigte, die ihre Stimme abgegeben haben"

#: helios/forms.py:40
msgid "voters who have not yet cast a ballot"
msgstr "Wahlberechtigte, die ihre Stimme noch nicht abgegeben haben"

#: helios/forms.py:50
#, python-format
msgid "Remove %(placeholders)s: it is only shown in the preview, and voters would receive it as is. Helios fills in each voter's details itself, so this box is only for your own message."
msgstr "Entfernen Sie %(placeholders)s: Dies wird nur in der Vorschau angezeigt, und Wahlberechtigte würden es unverändert erhalten. Helios fügt die Angaben jeder wahlberechtigten Person selbst ein, dieses Feld ist also nur für Ihre eigene Nachricht."

#: helios/forms.py:56
msgid "no one -- are you sure about this?"
msgstr "niemanden – sind Sie sicher?"

#: helios/forms.py:56
msgid "only voters who cast a ballot"
msgstr "nur Wahlberechtigte, die ihre Stimme abgegeben haben"

#: helios/forms.py:59 helios/forms.py:63
msgid "Voter ID"
msgstr "Wähler-ID"

#: helios/forms.py:60 helios_auth/auth_systems/ldapauth.py:27 helios_auth/auth_systems/password.py:39
#: helios_auth/templates/ldapauth/login.html:17 helios_auth/templates/ldapauth/login.html:18
msgid "Password"
msgstr "Passwort"

#: helios/forms.py:63
msgid "Enter the voter ID you were assigned for this election"
msgstr "Geben Sie die Wähler-ID ein, die Ihnen für diese Wahl zugewiesen wurde"

#: helios/models.py:79
msgid "Election"
msgstr "Wahl"

#: helios/models.py:80
msgid "Referendum"
msgstr "Abstimmung"

#: helios/models.py:399
msgid "Anyone can vote."
msgstr "Alle können abstimmen."

#: helios/models.py:408
#, python-format
msgid "any %(auth_system)s user"
msgstr "alle Personen mit %(auth_system)s-Konto"

#: helios/models.py:448
msgid "add questions to the ballot"
msgstr "Fragen zum Stimmzettel hinzufügen"

#: helios/models.py:455
msgid "add at least one trustee"
msgstr "mindestens eine*n Treuhänder*in hinzufügen"

#: helios/models.py:462
#, python-format
msgid "have trustee %(name)s generate a keypair"
msgstr "Treuhänder*in %(name)s ein Schlüsselpaar erzeugen lassen"

#: helios/models.py:468
msgid "enter your voter list (or open registration to the public)"
msgstr "Wählerverzeichnis eingeben (oder die Registrierung öffentlich freigeben)"

#: helios/models.py:486
#, python-format
msgid "Election was tallied more than %(weeks)s week ago"
msgid_plural "Election was tallied more than %(weeks)s weeks ago"
msgstr[0] "Die Wahl wurde vor mehr als %(weeks)s Woche ausgezählt"
msgstr[1] "Die Wahl wurde vor mehr als %(weeks)s Wochen ausgezählt"

#: helios/models.py:502
msgid "Election has been tallied"
msgstr "Die Wahl wurde ausgezählt"

#: helios/models.py:505
msgid "Tallying has started"
msgstr "Die Auszählung hat begonnen"

#: helios/models.py:847
#, python-format
msgid "invalid voter type '%(voter_type)s' for voter id '%(voter_id)s', available voter types are %(voter_types)s"
msgstr "ungültige Wählerart „%(voter_type)s“ für die Wähler-ID „%(voter_id)s“, verfügbare Wählerarten sind %(voter_types)s"

#: helios/models.py:856
#, python-format
msgid "invalid voter email '%(voter_email)s' for voter id '%(voter_id)s'"
msgstr "ungültige E-Mail-Adresse „%(voter_email)s“ für die Wähler-ID „%(voter_id)s“"

#: helios/tasks.py:143
msgid "encrypted tally computed"
msgstr "verschlüsselte Auszählung berechnet"

#: helios/tasks.py:144
#, python-format
msgid ""
"\n"
"The encrypted tally for election %(election)s has been computed.\n"
"\n"
"--\n"
"Helios\n"
msgstr ""
"\n"
"Die verschlüsselte Auszählung für die Wahl %(election)s wurde berechnet.\n"
"\n"
"--\n"
"Helios\n"

#: helios/tasks.py:161
msgid "Helios Decrypt"
msgstr "Helios-Entschlüsselung"

#: helios/tasks.py:162
#, python-format
msgid ""
"\n"
"Helios has decrypted its portion of the tally\n"
"for election %(election)s.\n"
"\n"
"--\n"
"Helios\n"
msgstr ""
"\n"
"Helios hat seinen Teil der Auszählung\n"
"für die Wahl %(election)s entschlüsselt.\n"
"\n"
"--\n"
"Helios\n"

#: helios/tasks.py:187
#, python-format
msgid ""
"\n"
"%(count)d row in the file was not added, because those voters were already\n"
"on the voter list (or listed twice in the file), or have opted out of\n"
"Helios emails. Opted-out voters are listed in a separate email.\n"
msgid_plural ""
"\n"
"%(count)d rows in the file were not added, because those voters were already\n"
"on the voter list (or listed twice in the file), or have opted out of\n"
"Helios emails. Opted-out voters are listed in a separate email.\n"
msgstr[0] ""
"\n"
"%(count)d Zeile der Datei wurde nicht übernommen, weil die Person bereits\n"
"im Wählerverzeichnis stand (oder doppelt in der Datei aufgeführt war) oder\n"
"Helios-E-Mails abbestellt hat. Personen, die E-Mails abbestellt haben, werden in einer separaten E-Mail aufgeführt.\n"
msgstr[1] ""
"\n"
"%(count)d Zeilen der Datei wurden nicht übernommen, weil diese Personen bereits\n"
"im Wählerverzeichnis standen (oder doppelt in der Datei aufgeführt waren) oder\n"
"Helios-E-Mails abbestellt haben. Personen, die E-Mails abbestellt haben, werden in einer separaten E-Mail aufgeführt.\n"

#: helios/tasks.py:197
#, python-format
msgid "%(count)d voter has been created."
msgid_plural "%(count)d voters have been created."
msgstr[0] "%(count)d wahlberechtigte Person wurde angelegt."
msgstr[1] "%(count)d Wahlberechtigte wurden angelegt."

#: helios/tasks.py:202
msgid "voter file processed"
msgstr "Wählerliste verarbeitet"

#: helios/tasks.py:203
#, python-format
msgid ""
"\n"
"Your voter file upload for election %(election)s\n"
"has been processed.\n"
"\n"
"%(created)s\n"
"%(skipped)s\n"
"--\n"
"Helios\n"
msgstr ""
"\n"
"Ihre hochgeladene Wählerliste für die Wahl %(election)s\n"
"wurde verarbeitet.\n"
"\n"
"%(created)s\n"
"%(skipped)s\n"
"--\n"
"Helios\n"

#: helios/tasks.py:226
#, python-format
msgid "Opted-out voters not added to election %(election)s"
msgstr "Wahlberechtigte mit abbestellten E-Mails nicht zur Wahl %(election)s hinzugefügt"

#: helios/tasks.py:228
#, python-format
msgid ""
"\n"
"The following %(count)d voter could not be added to election \"%(election)s\" \n"
"because they have opted out of receiving Helios emails:\n"
"\n"
msgid_plural ""
"\n"
"The following %(count)d voters could not be added to election \"%(election)s\" \n"
"because they have opted out of receiving Helios emails:\n"
"\n"
msgstr[0] ""
"\n"
"Die folgende %(count)d wahlberechtigte Person konnte nicht zur Wahl „%(election)s“ hinzugefügt werden, \n"
"weil sie Helios-E-Mails abbestellt hat:\n"
"\n"
msgstr[1] ""
"\n"
"Die folgenden %(count)d Wahlberechtigten konnten nicht zur Wahl „%(election)s“ hinzugefügt werden, \n"
"weil sie Helios-E-Mails abbestellt haben:\n"
"\n"

#: helios/tasks.py:239
#, python-format
msgid "- %(name)s (%(email)s) [ID: %(voter_id)s, Type: %(voter_type)s]"
msgstr "- %(name)s (%(email)s) [ID: %(voter_id)s, Typ: %(voter_type)s]"

#: helios/tasks.py:245
#, python-format
msgid ""
"\n"
"\n"
"These voters will need to opt back in before they can be added to elections.\n"
"They can opt back in at: %(optin_url)s\n"
"\n"
"--\n"
"Helios\n"
msgstr ""
"\n"
"\n"
"Diese Personen müssen den E-Mail-Empfang wieder aktivieren, bevor sie zu Wahlen hinzugefügt werden können.\n"
"Das ist hier möglich: %(optin_url)s\n"
"\n"
"--\n"
"Helios\n"

#: helios/templates/_castconfirm_docast.html:19
#, python-format
msgid "You are logged in as <u>%(voter_name)s</u>"
msgstr "Sie sind angemeldet als <u>%(voter_name)s</u>"

#: helios/templates/_castconfirm_docast.html:21
msgid "CAST this ballot"
msgstr "Diesen Stimmzettel ABGEBEN"

#: helios/templates/_castconfirm_docast.html:22
msgid "Only the last one counts."
msgstr "Nur der letzte zählt."

#: helios/templates/_castconfirm_docast.html:22
msgid "You can cast as many ballots as you want."
msgstr "Sie können beliebig oft einen Stimmzettel abgeben."

#: helios/templates/_castconfirm_docast.html:26
msgid "Are you sure you want to clear this ballot and NOT cast it?"
msgstr "Möchten Sie diesen Stimmzettel wirklich verwerfen und NICHT abgeben?"

#: helios/templates/_castconfirm_docast.html:26 helios/templates/combine_decryptions.html:6 helios/templates/election_admin_add.html:7
#: helios/templates/election_admin_remove.html:7 helios/templates/election_edit.html:6 helios/templates/election_extend.html:6
#: helios/templates/new_trustee.html:5 helios/templates/release_result.html:6
msgid "cancel"
msgstr "abbrechen"

#: helios/templates/_castconfirm_docast.html:27
msgid "If you cancel now, your ballot will <em>NOT</em> be recorded."
msgstr "Wenn Sie jetzt abbrechen, wird Ihr Stimmzettel <em>NICHT</em> erfasst."

#: helios/templates/_castconfirm_docast.html:28
msgid "You can start the voting process over again, of course."
msgstr "Sie können die Stimmabgabe natürlich erneut beginnen."

#: helios/templates/_castconfirm_docast.html:37
msgid "voting has stopped, sorry."
msgstr "Die Stimmabgabe ist leider beendet."

#: helios/templates/_castconfirm_docast.html:42
msgid "voting has not yet begun, sorry."
msgstr "Die Stimmabgabe hat leider noch nicht begonnen."

#: helios/templates/_castconfirm_password.html:10
msgid "bad voter ID or password, please try again."
msgstr "Wähler-ID oder Passwort falsch, bitte versuchen Sie es erneut."

#: helios/templates/_castconfirm_password.html:14
msgid "authenticate &amp; cast ballot"
msgstr "Anmelden &amp; Stimmzettel abgeben"

#: helios/templates/_castconfirm_password.html:16
msgid "Your voter ID and password can be found in the email you received."
msgstr "Ihre Wähler-ID und Ihr Passwort finden Sie in der E-Mail, die Sie erhalten haben."

#: helios/templates/_castconfirm_password.html:17
msgid "Forgot your password? Click here to resend it."
msgstr "Passwort vergessen? Klicken Sie hier, um es erneut zu senden."

#: helios/templates/_castconfirm_password.html:18
#, python-format
msgid "If you still cannot find your login information, contact your election administrator at <tt>%(help_email)s</tt>."
msgstr "Falls Sie Ihre Anmeldedaten weiterhin nicht finden, wenden Sie sich an die Wahlleitung unter <tt>%(help_email)s</tt>."

#: helios/templates/_castconfirm_password.html:21
msgid "Cast as many ballots as you wish: only the last one counts."
msgstr "Sie können beliebig oft einen Stimmzettel abgeben: Nur der letzte zählt."

#: helios/templates/_castconfirm_password.html:24
msgid "log in"
msgstr "Anmelden"

#: helios/templates/cast_done.html:3 helios/templates/election_cast_confirm.html:3 server_ui/templates/confirm.html:3
#: server_ui/templates/done.html:3
msgid "Confirm Vote"
msgstr "Stimmabgabe bestätigen"

#: helios/templates/cast_done.html:6
msgid "Vote Successfully Cast!"
msgstr "Stimme erfolgreich abgegeben!"

#: helios/templates/cast_done.html:10 helios/templates/election_cast_confirm.html:58 server_ui/templates/email/cast_vote_body.txt:5
msgid "Your ballot tracker is:"
msgstr "Ihr Stimmzettel-Tracker lautet:"

#: helios/templates/cast_done.html:14
msgid "This ballot tracker mathematically ensures that your ballot is counted."
msgstr "Dieser Stimmzettel-Tracker stellt mathematisch sicher, dass Ihr Stimmzettel gezählt wird."

#: helios/templates/cast_done.html:14
#, python-format
msgid "You can check all ballot trackers by viewing the <a href=\"%(voters_url)s\">voter list</a>, where your ballot tracker should appear within a few minutes."
msgstr "Alle Stimmzettel-Tracker können Sie im <a href=\"%(voters_url)s\">Wählerverzeichnis</a> überprüfen, wo Ihr Stimmzettel-Tracker innerhalb weniger Minuten erscheinen sollte."

#: helios/templates/cast_done.html:19
msgid "For your safety, we have logged you out."
msgstr "Zu Ihrer Sicherheit wurden Sie abgemeldet."

#: helios/templates/cast_done.html:25
msgid "return to election info"
msgstr "zurück zu den Informationen zur Wahl"

#: helios/templates/castvote.html:5
#, python-format
msgid "Cast Vote %(hash)s"
msgstr "Abgegebene Stimme %(hash)s"

#: helios/templates/castvote.html:6
#, python-format
msgid "cast in <a href=\"%(election_view_url)s\">%(election_name)s</a>"
msgstr "abgegeben in <a href=\"%(election_view_url)s\">%(election_name)s</a>"

#: helios/templates/castvote.html:7
msgid "Fingerprint:"
msgstr "Fingerabdruck:"

#: helios/templates/castvote.html:8
msgid "by"
msgstr "von"

#: helios/templates/castvote.html:16
msgid "details"
msgstr "Details"

