msgstr "Helios-Prüfprogramm für Wahlen"

#: heliosverifier/verify.html:41
msgid "loading verifier ..."
msgstr "Prüfprogramm wird geladen ..."

#: heliosverifier/verify.html:43
msgid "start verification"
msgstr "Überprüfung starten"

#: heliosverifier/verify.html:53
msgid "sorry, in-browser verification requires Java Support at this time."
msgstr "Die Überprüfung im Browser erfordert derzeit leider Java-Unterstützung."

#: heliosverifier/verify.html:61
msgid "FAIL"
msgstr "FEHLGESCHLAGEN"

#: heliosverifier/verify.html:61
