msgstr "Stimmzettel von wahlberechtigter Person #%(num)s GEFUNDEN"

#: heliosverifier/verify.html:110
msgid "Election"
msgstr "Wahl"

#: heliosverifier/verify.html:119
#, python-format
msgid "loaded election: %(name)s"
msgstr "Wahl geladen: %(name)s"

#: heliosverifier/verify.html:120
#, python-format
msgid "election fingerprint: %(hash)s"
msgstr "Fingerabdruck der Wahl: %(hash)s"

#: heliosverifier/verify.html:126
msgid "PROBLEM: this election is not a straight-forward homomorphic-tally election. As a result, Helios cannot currently verify it."
msgstr "PROBLEM: Diese Wahl ist keine einfache Wahl mit homomorpher Auszählung. Daher kann Helios sie derzeit nicht überprüfen."

#: heliosverifier/verify.html:135
msgid "loading list of voters..."
msgstr "Wählerverzeichnis wird geladen..."

#: heliosverifier/verify.html:139
msgid "loaded voter list, now loading ballots for each.."
msgstr "Wählerverzeichnis geladen, Stimmzettel werden geladen.."

#: heliosverifier/verify.html:144
