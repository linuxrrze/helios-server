# /etc/helios/helios.env: environment of helios-web and helios-worker (systemd EnvironmentFile).
# Install with: install -m 0640 -o root -g helios helios.env.example /etc/helios/helios.env
# fill in the two empty secrets (SECRET_KEY, EMAIL_OPTOUT_SECRET) and replace every CHANGE-ME.
# NEVER commit the real file. For Docker Compose, use
# ../.env.example instead (same variables, see "Which file?" in ../../../docs/configuration.md).
#
# Every variable Helios reads is listed, grouped as in ../../../docs/configuration.md, which explains
# them. Active lines are example settings for a site at vote.example.org with SAML single
# sign-on; commented-out lines show the default (or an example) and only need to be set to
# change it. Switches are on only with the value 1.
#
# Format: KEY=value, comments only on their own lines (systemd does not allow trailing
# comments). Values with spaces in double quotes, JSON in single quotes. The file is also read
# by sh for manage.py commands (set -a; . /etc/helios/helios.env; set +a), so avoid $ and
# backslashes in double-quoted values (sh would expand them); put such values in single quotes.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ============================================================================================
# 1. Core and security
# ============================================================================================
# must be 0 in production (1 also enables "devlogin": log in as anyone; settings.py defaults to 1)
DEBUG=0
# >= 32 random characters (generate it); rotating it logs everyone out
SECRET_KEY=
# random, different from SECRET_KEY (generate it); changing it invalidates outstanding opt-out links
EMAIL_OPTOUT_SECRET=
# comma-separated
ALLOWED_HOSTS=vote.example.org
# HTTPS redirect + secure cookies; the reverse proxy must set X-Forwarded-Proto
SSL=1
# HSTS for a year, including all subdomains
HSTS=1
# don't change: Lax is part of the CSRF protection and needed by SAML/OIDC
# SESSION_COOKIE_SAMESITE=Lax
# CSP_REPORT_ONLY=0
# CSP_REPORT_URI=https://csp.example.org/report
# automatic timestamps, and the default of ELECTION_TIME_ZONE
# TIME_ZONE=UTC
# zone in which election start/end are entered and shown (stored in UTC); UTC for the old behaviour
# ELECTION_TIME_ZONE=Europe/Berlin
# en or de, for visitors whose browser prefers neither
# LANGUAGE_CODE=en
# receives server error mails; a team address
ADMIN_EMAIL=CHANGE-ME@example.org
ADMIN_NAME="Helios Admins"
# subject prefix of those error mails (default [Helios])
# EMAIL_SUBJECT_PREFIX=[Helios]

# ============================================================================================
# 2. URLs
# ============================================================================================
URL_HOST=https://vote.example.org
# never change once elections exist (it is part of each election's cast URL)
SECURE_URL_HOST=https://vote.example.org

# ============================================================================================
# 3. Database
# ============================================================================================
# local PostgreSQL over the unix socket, peer authentication as OS user helios: no password,
# no TLS needed
DATABASE_URL=postgres://helios@/helios
DATABASE_SSL_REQUIRE=0
# remote database: DATABASE_URL=postgres://helios:PASSWORD@db.example.org/helios with
# DATABASE_SSL_REQUIRE=1 (the default)

# ============================================================================================
# 4. Email
# ============================================================================================
# --- SMTP, option 1: relay with login ---
EMAIL_HOST=smtp-relay.example.org
# 587 STARTTLS, 465 implicit TLS (default 2525)
EMAIL_PORT=587
# always TLS with a login, otherwise the password may go out unencrypted; never both
EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
EMAIL_HOST_USER=CHANGE-ME
EMAIL_HOST_PASSWORD=CHANGE-ME
# seconds before giving up on a hanging mail server
# EMAIL_TIMEOUT=60
# --- option 2: local MTA on this host (e.g. Postfix), which relays the mail ---
# EMAIL_HOST=localhost
# EMAIL_PORT=25
# EMAIL_USE_TLS=0

# --- sender and contact (the relay must allow this sender for EMAIL_HOST_USER) ---
DEFAULT_FROM_EMAIL=helios@example.org
DEFAULT_FROM_NAME="Example University Helios"
# a team/functional address, not a person
HELP_EMAIL_ADDRESS=CHANGE-ME@example.org
# weeks after the tally from which voters can no longer be emailed
# HELIOS_VOTER_EMAIL_CUTOFF_WEEKS=3

# --- other ways to send, instead of SMTP ---
# print mails to the log instead of sending (only with DEBUG=1)
# EMAIL_USE_CONSOLE=0
# MAILGUN_API_KEY=
# Amazon SES (region us-east-1); wins over MAILGUN_API_KEY
# EMAIL_USE_AWS=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================================================================
# 5. Site and interface
# ============================================================================================
# _DE variants are used when the page is in German (per-language texts)
SITE_TITLE="Example University Helios"
# SITE_TITLE_DE=
# may contain HTML (output as is)
WELCOME_MESSAGE="This is the Helios voting server of Example University."
# WELCOME_MESSAGE_DE=
# MAIN_LOGO_URL=/static/logo.png
# SHOW_LOGIN_OPTIONS=1
# SHOW_USER_INFO=1
# ALLOW_ELECTION_INFO_URL=0

# --- organization and layout (all optional; see "Customizing the site") ---
ORGANIZATION_NAME="Example University"
# ORGANIZATION_NAME_DE=
ORGANIZATION_URL=https://www.example.org
# small logo in the header bar, and a light one for the dark footer background
# ORGANIZATION_LOGO_URL=/static/site/logo.svg
# FOOTER_LOGO_URL=/static/site/logo-white.svg
# extra stylesheet after /static/layout.css (CSS variables for colors, background image)
# SITE_CSS_URL=/static/site/site.css
# auto: follow the visitor's dark mode (default without SITE_CSS_URL), off: always light
# DARK_MODE=auto
# footer links, shown only when set; /imprint and /accessibility need templates in
# SITE_TEMPLATES_DIR, /privacy is a generic built-in page (empty: no link)
# IMPRINT_URL=/imprint
# PRIVACY_URL=/privacy
# ACCESSIBILITY_URL=/accessibility
# further footer links, JSON in single quotes
# FOOTER_LINKS='[{"url": "https://help.example.org", "text": "Help desk"}]'
# site directory (see "Customizing the site" in configuration.md); nginx can serve the
# static part directly (nginx-helios.conf)
# SITE_TEMPLATES_DIR=/opt/helios/site/templates
# SITE_STATIC_DIR=/opt/helios/site/static

# ============================================================================================
# 6. Login
# ============================================================================================
# Voters with per-election passwords need none of these. Election administrators log in via
# single sign-on, registered as auth system "campus" (SAML or OIDC; details in sso.md).
AUTH_ENABLED_SYSTEMS=campus
AUTH_DEFAULT_SYSTEM=campus

# --- Option A: SAML (needs: uv sync --extra saml) ---
SAML_AUTH_SYSTEM_NAME=campus
SAML_LOGIN_MESSAGE="Log in with Example University SSO"
SAML_LOGIN_MESSAGE_DE="Mit Example University SSO anmelden"
SAML_IDP_METADATA_URL=https://idp.example.org/idp/shibboleth
# local copy instead of the URL
# SAML_IDP_METADATA_FILE=/run/helios/idp-metadata.xml
# only if the metadata lists several IdPs
# SAML_IDP_ENTITY_ID=
# pin the IdP signing certificate instead of trusting the metadata
# SAML_IDP_X509_CERT=
# defaults derived from SECURE_URL_HOST; set them to keep an existing IdP registration
# SAML_SP_ENTITY_ID=https://vote.example.org/auth/saml/metadata
# SAML_SP_ACS_URL=https://vote.example.org/auth/saml/acs
# only if the IdP wants signed requests or encrypts assertions: the base64 content of the PEM
# files on one line, without the BEGIN/END lines (systemd keeps "\n" literally)
# SAML_SP_X509_CERT=MIIC...
# SAML_SP_PRIVATE_KEY=MIIE...
# default nameid; the email attribute makes user ids case-insensitive
SAML_ATTRIBUTE_USER_ID=urn:mace:dir:attribute-def:mail
SAML_ATTRIBUTE_EMAIL=urn:mace:dir:attribute-def:mail
# full name, or given name + surname
# SAML_ATTRIBUTE_NAME=
SAML_ATTRIBUTE_GIVEN_NAME=urn:mace:dir:attribute-def:givenName
SAML_ATTRIBUTE_SURNAME=urn:mace:dir:attribute-def:sn

# --- Option B: OIDC; comment out all SAML_* lines above ---
# OIDC_AUTH_SYSTEM_NAME=campus
# OIDC_LOGIN_MESSAGE="Log in with Example University SSO"
# OIDC_LOGIN_MESSAGE_DE="Mit Example University SSO anmelden"
# OIDC_DISCOVERY_URL=https://idp.example.org/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES="openid email profile"
# default sub; email keeps the identities of a SAML setup keyed on the email address
# OIDC_USER_ID_CLAIM=email
# only if the IdP does not send email_verified (institutional IdP)
# OIDC_TRUST_UNVERIFIED_EMAIL=0
# also end the SSO session on logout; needs end_session_endpoint at the IdP and
# https://vote.example.org/auth/logout/done registered as post-logout redirect URI
# OIDC_LOGOUT_AT_PROVIDER=0

# --- other login systems (only effective if listed in AUTH_ENABLED_SYSTEMS) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub
# GH_CLIENT_ID=
# GH_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_API_KEY=
# FACEBOOK_API_SECRET=
# CAS_USERNAME=
# CAS_PASSWORD=
# CAS_ELIGIBILITY_URL=
# CAS_ELIGIBILITY_REALM=
# LDAP cannot be configured through the environment (see configuration.md, section 6).
# Old names, still read: AUTH_ENABLED_AUTH_SYSTEMS, AUTH_DEFAULT_AUTH_SYSTEM.

# ============================================================================================
# 7. Monitoring
# ============================================================================================
# ROLLBAR_ACCESS_TOKEN=

# Read by settings.py but without effect: MASTER_HELIOS.
